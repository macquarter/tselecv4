{
  "images": {
    "remotePatterns": [
      { "protocol": "https", "hostname": "firebasestorage.googleapis.com" }
    ],
    "sizes": [640, 750, 828, 1080, 1200, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 31536000
  },
  "rewrites": [{ "source": "/((?!_vercel/).*)", "destination": "/index.html" }]
}
